# SentinelAI Environment Configuration
# Copy this file to .env and edit before production deployment

# ── Security ──────────────────────────────────────────────────────────
# CHANGE THIS in production — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sentinelai-super-secret-key-change-in-production-2024

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────
# Local product mode uses SQLite. For server deployment, point this to a
# persistent volume path. The schema mirrors PostgreSQL tables for migration.
SECUROX_DB_PATH=backend/database/securox.db

# Initial local accounts are seeded with password: admin123
# admin / analyst / traffic / finance / emergency

# ── ML Settings ───────────────────────────────────────────────────────
IF_CONTAMINATION=0.05       # Expected anomaly rate for Isolation Forest
LSTM_WINDOW=20              # Look-back window for LSTM predictor
LSTM_HORIZON=5              # How many steps ahead to predict

# ── Alert Thresholds ──────────────────────────────────────────────────
ALERT_THRESHOLD_RISK=40     # Minimum risk score to raise alert
ALERT_THRESHOLD_ANOMALY=0.5 # Minimum anomaly score to flag
